import tkinter as tk
from tkinter import messagebox
import math

# Product specifications (dummy data for portfolio)
product_specs = {
    "HOSE_A_001": {"length_per_item": 0.50, "weight_per_item": 0.25, "time_per_item": 0.5},
    "HOSE_B_002": {"length_per_item": 0.65, "weight_per_item": 0.30, "time_per_item": 0.6},
    "HOSE_C_003": {"length_per_item": 0.40, "weight_per_item": 0.20, "time_per_item": 0.4},
    "HOSE_D_004": {"length_per_item": 0.75, "weight_per_item": 0.35, "time_per_item": 0.7},
    "HOSE_E_005": {"length_per_item": 0.55, "weight_per_item": 0.28, "time_per_item": 0.5},
}

# Material specifications (dummy data for portfolio)
material_specs = {
    "MAT_X": {"weight_per_roll": 30.0},
    "MAT_Y": {"weight_per_roll": 25.0},
}

def calculate():
    try:
        num_orders = int(entry_orders.get())
        product_code = entry_product.get()
        material_type = entry_material.get()

        if product_code not in product_specs:
            messagebox.showerror("Error", f"Product code '{product_code}' not found.")
            return
        if material_type not in material_specs:
            messagebox.showerror("Error", f"Material type '{material_type}' not found.")
            return

        product_info = product_specs[product_code]
        material_info = material_specs[material_type]

        length_per_item = product_info["length_per_item"]
        weight_per_item = product_info["weight_per_item"]
        time_per_item = product_info["time_per_item"]
        weight_per_roll = material_info["weight_per_roll"]

        total_length = num_orders * length_per_item
        total_weight = (num_orders * weight_per_item) * 1.10  # +10% buffer
        rolls_needed = math.ceil(total_weight / weight_per_roll)
        total_time = ((num_orders * time_per_item) + 60) / 60  # hours

        label_result.config(
            text=f"Total Length: {total_length:.2f} m\n"
                 f"Total Weight: {total_weight:.2f} kg\n"
                 f"Rolls Needed: {rolls_needed} roll(s)\n"
                 f"Total Time: {total_time:.2f} hours"
        )

    except ValueError:
        messagebox.showerror("Input Error", "Please enter valid numbers.")

# GUI Setup
root = tk.Tk()
root.title("Production Planning Calculator")
root.geometry("500x400")

tk.Label(root, text="Number of Orders:").pack(pady=5)
entry_orders = tk.Entry(root)
entry_orders.pack()

tk.Label(root, text="Product Code (e.g., HOSE_A_001):").pack(pady=5)
entry_product = tk.Entry(root)
entry_product.pack()

tk.Label(root, text="Material Type (e.g., MAT_X):").pack(pady=5)
entry_material = tk.Entry(root)
entry_material.pack()

tk.Button(root, text="Calculate", command=calculate).pack(pady=20)

label_result = tk.Label(root, text="Results will be shown here.", font=("Arial", 12))
label_result.pack(pady=10)

root.mainloop()
